# 复制本文件为 .env 后填写。不要把真实密钥提交到版本库。
OPENAI_API_KEY=replace-with-your-api-key

# OpenAI 官方接口可省略本项；使用 DeepSeek 或内部 OpenAI 兼容网关时填写。
OPENAI_BASE_URL=https://api.openai.com/v1

# 必须填写网关实际支持的、具备工具调用能力的模型名。
OPENAI_MODEL=gpt-4o-mini

# 教学项目默认使用低温度，让路由、结构化输出和测试更稳定。
OPENAI_TEMPERATURE=0

# 可选：打开 LangSmith 追踪。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langgraph-chinese-demo

# 数据中台治理图：MongoDB 持久化检查点。
# 请复制为 .env 并填写实际 URI；不要将用户名、密码或完整 URI 提交到仓库。
# MONGO_SERVER 可由部署环境覆盖；URI 中的 ${MONGO_SERVER} 会由 python-dotenv 展开。
MONGO_SERVER=mongo-dev1.e-tudou.com:27017
MONGODB_URI=mongodb://<username>:<password>@${MONGO_SERVER}/potato_data_platform
MONGODB_DATABASE=potato_data_platform

# LangGraph MongoDBSaver 使用的独立集合名，避免与其他应用集合混用。
MONGODB_CHECKPOINT_COLLECTION=langgraph_checkpoints
MONGODB_CHECKPOINT_WRITES_COLLECTION=langgraph_checkpoint_writes

# 启动阶段 MongoDB 不可达时的最大等待时间，单位毫秒。
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
