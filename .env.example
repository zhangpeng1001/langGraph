# 复制本文件为 .env 后填写。不要把真实密钥提交到版本库。
OPENAI_API_KEY=replace-with-your-api-key

# OpenAI 官方接口可省略本项；使用 DeepSeek 或内部 OpenAI 兼容网关时填写。
OPENAI_BASE_URL=https://api.openai.com/v1

# 必须填写网关实际支持的、具备工具调用能力的模型名。
OPENAI_MODEL=gpt-4o-mini

# 教学项目默认使用低温度，让路由、结构化输出和测试更稳定。
OPENAI_TEMPERATURE=0

# 可选：打开 LangSmith 追踪。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langgraph-chinese-demo

